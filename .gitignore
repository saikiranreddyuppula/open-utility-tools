# dependencies
/node_modules
**/node_modules
.pnp
.pnp.*

# next.js
/.next/
/out/
next-env.d.ts

# generated OG images (rendered in prebuild / `bun run og:gen`, regenerable)
/public/og/

# production
/build

# published package build output (CI rebuilds from source)
/packages/*/dist
# generated API docs (TypeDoc, regenerable)
/packages/*/docs-api
# guard: lib/ is .ts source — never commit emitted declarations there
/lib/**/*.d.ts

# rust / wasm
/rust/target
**/target
/rust/**/pkg
/lib/wasm/generated
# NOTE: public/wasm (prebuilt wasm-pack output, ~1.8MB) IS committed so CI/Cloudflare
# builds don't need a Rust toolchain. Regenerate with `bun run wasm:build` when crates change.

# misc
.DS_Store
*.pem
.vscode/*
!.vscode/extensions.json
.idea

# debug / logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# env
.env*.local
.env

# typescript
*.tsbuildinfo

# bun
# (commit bun.lock for reproducible installs)

# harness local state
.claude/

# selftest artifacts + codex test harness
scripts/_*

# tool-generation / testing scaffolding (working artifacts, regenerable)
docs/_*
docs/NEW-TOOLS-PLAN.json
docs/NEW-TOOLS-FINAL.json
